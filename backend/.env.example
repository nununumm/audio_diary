# Copy this file to `.env` and fill in the values.

# --- Security ---
# Long random string used to sign the login session cookie.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
DIARY_SECRET_KEY=change-me-to-a-long-random-string

# Single-user login password for the app.
DIARY_PASSWORD=change-me

# --- Storage ---
# Where the SQLite DB and photos are stored (relative paths are fine).
DIARY_DATA_DIR=./data

# --- Transcription provider ---
# "gemini"     -> transcribe with Gemini (only needs GEMINI_API_KEY, recommended)
# "google_stt" -> transcribe with Google Cloud Speech-to-Text
#                 (requires google-cloud-speech + GOOGLE_APPLICATION_CREDENTIALS)
DIARY_TRANSCRIBER=gemini

# --- Gemini (used for text cleanup always; also for transcription when
#     DIARY_TRANSCRIBER=gemini). Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Google Cloud Speech-to-Text (only if DIARY_TRANSCRIBER=google_stt) ---
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# DIARY_STT_LANGUAGE=ja-JP
